<!DOCTYPE html>
<html>
<head>
    <title>Attendance Tracker</title>
</head>

<body>

<h1>Student Attendance Tracker</h1>

<input type="text" id="name" placeholder="Student Name"><br><br>

<input type="number" id="total" placeholder="Total Classes"><br><br>

<input type="number" id="present" placeholder="Classes Attended"><br><br>

<button onclick="calculate()">Calculate</button>

<h3 id="result"></h3>

<script>
function calculate() {
    let name = document.getElementById("name").value;
    let total = Number(document.getElementById("total").value);
    let present = Number(document.getElementById("present").value);

    let percentage = (present / total) * 100;

    document.getElementById("result").innerHTML =
        "Student: " + name + "<br>" +
        "Attendance: " + percentage.toFixed(2) + "%";
}
</script>

</body>
</html>